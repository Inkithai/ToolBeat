# Public site origin used for metadataBase, canonical URLs, the sitemap,
# robots.txt and JSON-LD. No trailing slash.
#
# Local development can omit this — the app falls back to http://localhost:3000.
# Production / preview deployments MUST set this to the real public URL:
#   https://convertlab.vercel.app
NEXT_PUBLIC_SITE_URL=https://convertlab.vercel.app
